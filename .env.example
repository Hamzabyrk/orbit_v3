# Supabase → Settings → API Keys
VITE_SUPABASE_URL=

# `sb_publishable_…` biçimini kullanın, `eyJ…` ile başlayan legacy anon
# anahtarını DEĞİL.
#
# İkisi de geçerli ve ikisi de tasarım gereği public — fark güvenlikte değil,
# bağımlılıkta: legacy anahtar projenin JWT secret'ıyla imzalıdır, dolayısıyla
# secret döndürüldüğünde birlikte geçersiz olur. Yeni biçim imzalı değildir ve
# bağımsız döndürülebilir. Ayrıntı: `.ai/PLATFORM_SETTINGS.md` bölüm 4.
#
# Bu satır #151'den sonra yazıldı: yerel ve production farklı biçimler
# taşıyordu, çünkü ikisi farklı zamanlarda kuruldu ve arada Supabase'in
# varsayılanı değişti. Kimse yanlış bir şey yapmadı — sadece hangisinin
# beklendiği hiçbir yerde yazmıyordu.
VITE_SUPABASE_ANON_KEY=

# `VITE_` önekli her değişken tarayıcıya iner ve JS paketine düz metin olarak
# gömülür. Buraya gizli bir değer (service_role, sb_secret_…, JWT secret)
# KONULAMAZ.
#
# Optional local override. Vercel injects VERCEL_ENV automatically at build time.
VITE_DEPLOYMENT_ENV=development
